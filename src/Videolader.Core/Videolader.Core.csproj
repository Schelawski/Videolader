<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that does not need Windows Forms: input parsing, yt-dlp calls, YouTube API,
    subtitle conversion, file handling. Targets plain net10.0 so the tests also run outside Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Videolader.Core</RootNamespace>
    <AssemblyName>Videolader.Core</AssemblyName>
    <!-- Debug info inside the DLL, so publishing leaves no Videolader.Core.pdb next to Videolader.exe -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Videolader.Tests" />
  </ItemGroup>

  <!-- Help texts, one Markdown file per language (see HelpDocument.cs).
       WithCulture="false": "help.de.md" is not a satellite resource for the culture "de". -->
  <ItemGroup>
    <EmbeddedResource Include="Help\help.*.md" LogicalName="Videolader.Help.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
