<Project>
  <!--
    Version of all projects (app, core library, tests). Release builds override it from the Git tag
    (v1.2.3 → -p:Version=1.2.3, see .github/workflows/release.yml), so this value only matters for local builds.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
